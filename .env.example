# LLM Configuration
# Primary provider: gemini | ollama | mock
LLM_PROVIDER=mock
# Optional secondary fallback provider (e.g. mock | ollama).
# Leave empty to fail fast with AI_UNAVAILABLE instead of unprompted mock fallbacks.
LLM_FALLBACK_PROVIDER=

# Gemini API settings (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama settings (required when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Application & Database Settings
DB_PATH=data/approval_system.db
ESCALATION_THRESHOLD_HOURS=24
